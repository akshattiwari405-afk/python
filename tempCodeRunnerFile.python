numGrades = int(input("Please enter number of grades "))
grades = []
for j in range(0,numGrades):
    grade = float(input("Enter a grade "))
    grades.append(grade)
highest_grade = grades[0]
for i in range(0,numGrades):
    if highest_grade<=grades[i]:
        highest_grade = grades[i]
    
print("highest grade is " , highest_grade)
lowest_grade = grades[0]
for i in range(0,numGrades):
    if lowest_grade>=grades[i]:
        lowest_grade = grades[i]
    
print("lowest grade is " , lowest_grade)